EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Obligatorias para arrancar la app. Sin ellas el cliente falla enseguida (fail-fast).

# RevenueCat (Test Store usa una sola key; en prod usa iOS/Android)
EXPO_PUBLIC_REVENUECAT_API_KEY=test_YOUR_REVENUECAT_TEST_KEY
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx

# Solo para scripts locales (nunca en la app cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secrets de Edge Functions (Dashboard → Edge Functions → Secrets)
# REVENUECAT_SECRET_API_KEY=sk_xxx
# REVENUECAT_WEBHOOK_SECRET=choose-a-long-random-string
# PUSH_DISPATCH_SECRET=choose-a-long-random-string
# EXPO_ACCESS_TOKEN=expo_access_token_from_expo_dev
# Also store PUSH_DISPATCH_SECRET in Supabase Vault as name: push_dispatch_secret
#   (used by Postgres triggers via pg_net)
